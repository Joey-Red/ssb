{
  "name": "ssbu-training-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-static-data.mjs",
    "predev": "npm run prepare:data",
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run --passWithNoTests",
    "prebuild": "npm run prepare:data",
    "build": "npm run test:run && tsc -b && vite build",
    "check": "npm run lint && npm run build",
    "preview": "vite preview",
    "visual:discover:ufd": "python scripts/discover-ufd-visuals.py",
    "visual:discover:external": "python scripts/discover-external-visuals.py",
    "visual:reconcile": "python scripts/reconcile-external-visuals.py",
    "visual:vendor": "python scripts/vendor-full-motion-assets.py",
    "visual:index": "python scripts/build-runtime-visual-index.py",
    "visual:audit": "python scripts/audit-visual-coverage.py",
    "visual:capture-queue": "python scripts/build-visual-capture-queue.py",
    "visual:synthetic-fallbacks": "python scripts/build-synthetic-visual-fallbacks.py"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
